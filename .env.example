# Razorpay credentials (get from https://dashboard.razorpay.com/app/keys)
# Use test keys for development, live keys for production

# Frontend (safe to expose - this is the public key)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Backend (Netlify Functions - set in Netlify dashboard > Site > Environment Variables)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase (service role key - NEVER expose in frontend)
SUPABASE_URL=https://mmzigliyulzwvqmlqhmx.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
